/admin/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

# Los assets NO llevan hash en el nombre (style.css, main.js, logo.png),
# así que no se cachean como "immutable": si se edita uno, el cambio tiene
# que llegar al visitante en horas, no en un año.

/img/*
  Cache-Control: public, max-age=604800

/css/*
  Cache-Control: public, max-age=86400

/js/*
  Cache-Control: public, max-age=86400
